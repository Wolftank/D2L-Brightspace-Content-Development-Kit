{
  "name": "cdk-desktop",
  "productName": "CDK",
  "version": "0.1.0",
  "private": true,
  "description": "The Windows app: starts the back end, opens the CDK window, and stops everything on close",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package": "electron-builder --win --publish never",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cdk-back-end": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "electron": "^42.11.18",
    "electron-builder": "26.17.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  }
}
