# Back-end settings. Every setting is optional; each comment says what applies
# while its line stays commented out, and the value shown is an example.
# To change a setting, copy this file to back-end/.env
#   Copy-Item .env.example .env
# and uncomment the line. A variable already set in the environment wins over
# this file. Restart the back end after editing .env.

# The agent that runs turns. Supported: claude. Default: claude.
# AGENT_DRIVER=claude

# The model the agent uses. Default: the agent's default for the signed-in account.
# AGENT_MODEL=claude-sonnet-5

# How much reasoning effort the agent spends: low, medium, high, xhigh, or max.
# Default: the agent's default.
# AGENT_EFFORT=high

# The most model calls one request may make. A request that needs more stops
# with "The request needed more steps than allowed." A whole number, 1 or more.
# Default: 60. Real requests took 9 to 27 steps (median 19, measured October
# 2026), so 60 gives a build-and-fix request over twice the steps of the largest
# one while still ending a request that runs away.
# AGENT_MAX_STEPS=40

# The most one request may spend, in US dollars. A request that reaches it stops
# with "The request reached its spending limit." A number greater than 0, such
# as 2.5. Default: 10. Real requests cost $0.92 to $3.25 (median $1.77), about
# $0.12 a step, so a runaway request usually reaches the step limit first (60
# steps is about $7); this limit catches steps that cost far more than usual.
# Claude reports each request's cost at API prices and applies this limit to it
# even when the account is billed by subscription. An agent that reports no
# cost is not limited by it.
# AGENT_MAX_BUDGET_USD=5

# The port the back end listens on at 127.0.0.1, a whole number from 1 to 65535.
# Default: 3000. When you change it, point the front end at it with
# API_TARGET=http://127.0.0.1:<port>.
# PORT=4000

# Where the database, workspaces, and builds are stored. A relative path is
# resolved against back-end/. Default: %LOCALAPPDATA%\CDK on Windows, ~/.cdk elsewhere.
# DATA_DIR=D:\CDK

# The origin the app is opened at, and the only one allowed to frame build
# previews. Default: http://127.0.0.1:5173, the Vite dev server. Previews are
# served on http://preview.localhost:<PORT>.
# APP_ORIGIN=http://127.0.0.1:3000

# Read by the Claude CLI, not by the back end. Default: the Claude sign-in on
# this machine. The agent's shell commands can read it too.
# ANTHROPIC_API_KEY=your-api-key
