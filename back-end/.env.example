# Backend settings. Copy this file to `.env` in `back-end/` and adjust as
# needed; every setting is optional and falls back to the default shown.
# A real environment variable always takes precedence over a value here.

# The agent that builds the content. Supported: claude
AGENT_DRIVER=claude

# The TCP port the back end listens on, an integer from 1 to 65535.
PORT=3000

# Where projects, workspaces, builds, and the database live. A relative path
# is resolved against the directory the back end starts from.
# Default: %LOCALAPPDATA%\CDK on Windows, ~/.cdk elsewhere.
#DATA_DIR=C:\Users\me\AppData\Local\CDK
